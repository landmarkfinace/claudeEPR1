# ─────────────────────────────────────────────────────────────────────────────
# Landmark Inter Gulf — Environment configuration
# Copy to .env and adjust for your server:
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# SQLite database location (Prisma resolves this path).
# RECOMMENDED on a VPS: use an ABSOLUTE path so the production (standalone)
# server and the CLI tools always hit the same file.
DATABASE_URL=file:/opt/claudeEPR1/db/custom.db

# ── Print-to-PDF daemon (server-side vector PDFs) ──────────────────────────
# The app spawns scripts/print/render-daemon.mjs on demand; it needs a
# Chromium/Chrome executable. On Ubuntu install Google Chrome:
#   wget -q -O - https://dl.google.com/linux/linux_signing_key.pub | sudo gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg
#   echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] http://dl.google.com/linux/chrome/deb/ stable main" | sudo tee /etc/apt/sources.list.d/google-chrome.list
#   sudo apt update && sudo apt install -y google-chrome-stable
# If Chrome lives somewhere else, set the full path here:
#PRINT_CHROME=/usr/bin/google-chrome-stable
#PRINT_DAEMON_PORT=3901

# ── First-run bootstrap ONLY (bun run db:bootstrap) ─────────────────────────
# Creates the Super Admin user together with the company configuration.
# Not needed again after the first run.
#ADMIN_EMAIL=boss@company.com
#ADMIN_PASSWORD=ChangeMe-Strong-Password
